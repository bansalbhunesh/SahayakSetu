# --- Production (backend): MODERATION_STRICT=true, CHAT_COMPLETIONS_SECRET=<secret + Vapi credential> ---

# Qdrant (cloud or local via docker-compose)
# When using `docker-compose up`, the compose file sets QDRANT_URL=http://qdrant:6333 for the backend service.
# For Qdrant Cloud, set QDRANT_URL and QDRANT_API_KEY here; for local Qdrant without auth, QDRANT_API_KEY may be empty.
QDRANT_URL=
QDRANT_API_KEY=

# Google AI Studio
GEMINI_API_KEY=

# Optional Groq fallback
GROQ_API_KEY=

# Public backend URL (Vapi webhooks, assistant config)
BACKEND_URL=

# Optional: if set, POST /chat/completions requires Authorization: Bearer <same value>
# or header X-SahayakSetu-Key: <same value> (configure matching credential in Vapi custom LLM).
CHAT_COMPLETIONS_SECRET=

# Moderation: true/1/yes = fail-closed on classifier JSON/call errors (recommended in production).
MODERATION_STRICT=false

# Gemini model id (e.g. gemini-2.0-flash)
CHAT_MODEL=gemini-2.0-flash

# Vapi dashboard
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
